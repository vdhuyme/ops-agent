# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here
LANGSMITH_API_KEY=

# Database connection string for your Postgres database. For example: postgresql://username:password@host:port/database?sslmode=disable
POSTGRES_URI=

# -----------------------------------------------------------------------------
# Frontend (ops-agent-ui Next.js) — copy these lines into:
#   ops-agent-ui/apps/web/.env.local   (NOT committed, gitignored)
# Without these two vars set, the UI shows a "Continue" form asking for them.
# LangGraph dev defaults are http://localhost:2024 + graph "agent".
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent