# This is an example environment file for the web application. You can copy this file to .env.local and modify the values as needed.
NEXT_PUBLIC_API_URL=http://192.168.1.111:3000/api/langgraph

# The ID of the assistant to use. This should match the assistant ID configured in the backend.
NEXT_PUBLIC_ASSISTANT_ID=agent

# The URL of the LangGraph backend. This should point to the backend server that the web application will communicate with.
LANGGRAPH_BACKEND_URL=http://192.168.1.111:2024
